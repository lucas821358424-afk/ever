<UserControl x:Class="EverInspection.Client.Views.DynamicFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="{Binding TemplateName}" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="{Binding TemplateVersion, StringFormat=版本: {0}}" FontSize="14"/>
            <CheckBox Content="允许提交超规格数据" IsChecked="{Binding AllowSubmitOutOfSpec}" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="保存草稿" Width="140" Height="42" Command="{Binding SaveDraftCommand}"/>
            <Button Content="提交" Width="140" Height="42" Margin="12,0,0,0" Command="{Binding SubmitCommand}"/>
            <TextBlock Text="{Binding SaveHint}" VerticalAlignment="Center" Margin="16,0,0,0" />
        </StackPanel>

        <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="All" HeadersVisibility="Column" FontSize="15">
            <DataGrid.Columns>
                <DataGridTextColumn Header="制程" Binding="{Binding Process}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="点检项目" Binding="{Binding CheckItem}" IsReadOnly="True" Width="2*"/>
                <DataGridTextColumn Header="单位" Binding="{Binding Unit}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Min" Binding="{Binding Min}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Max" Binding="{Binding Max}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="点检值" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOutOfSpec}" Value="True">
                                    <Setter Property="Background" Value="#FFB71C1C"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOutOfSpec}" Value="True">
                                    <Setter Property="Background" Value="#FFB71C1C"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
