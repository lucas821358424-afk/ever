<UserControl x:Class="EverInspection.Client.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="开始日期" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <DatePicker SelectedDate="{Binding StartDate}" Width="140"/>
            <TextBlock Text="结束日期" VerticalAlignment="Center" Margin="12,0,8,0"/>
            <DatePicker SelectedDate="{Binding EndDate}" Width="140"/>
            <TextBlock Text="模板ID" VerticalAlignment="Center" Margin="12,0,8,0"/>
            <TextBox Text="{Binding TemplateId, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
            <Button Content="查询" Width="100" Margin="12,0,0,0" Command="{Binding QueryCommand}"/>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Records}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" GridLinesVisibility="All">
            <DataGrid.Columns>
                <DataGridTextColumn Header="记录ID" Binding="{Binding FormInstanceId}" Width="2*"/>
                <DataGridTextColumn Header="模板ID" Binding="{Binding TemplateId}" Width="*"/>
                <DataGridTextColumn Header="版本" Binding="{Binding TemplateVersion}" Width="*"/>
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="*"/>
                <DataGridTextColumn Header="超规格" Binding="{Binding HasOutOfSpec}" Width="*"/>
                <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
