<Window x:Class="Client.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="离线电子表单客户端" Height="800" Width="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="12">
            <Button Content="导入Excel模板" Width="140" Margin="0,0,8,0" Click="ImportExcelTemplate_Click" />
            <Button Content="加载示例模板" Width="140" Margin="0,0,8,0" Click="LoadTemplate_Click" />
            <Button Content="校验" Width="80" Margin="0,0,8,0" Click="Validate_Click" />
            <TextBlock Name="StatusText" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Canvas Name="FormCanvas" Background="#FFF7F7F7" Width="1400" Height="1000" />
        </ScrollViewer>

        <TextBlock Grid.Row="2" Margin="12" Foreground="Gray"
                   Text="说明：示例展示动态控件渲染、离线存储、基础校验报警（背景标红+消息提示）。" />
    </Grid>
</Window>
